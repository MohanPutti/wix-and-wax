# Bearer tokens for admins — comma-separated. Generate with: openssl rand -hex 32
MCP_TOKENS=token_admin_1,token_admin_2,token_admin_3

# Server
PORT=3100

# Database (points to Docker mysql service by default)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=wix_and_wax
DB_USER=mcp_readonly
DB_PASSWORD=change_me

# Safety rails
MCP_STATEMENT_TIMEOUT_MS=5000
MCP_DEFAULT_LIMIT=1000
DB_POOL_SIZE=5
